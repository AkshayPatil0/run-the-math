---
import Layout from '../layouts/Layout.astro';

const lastUpdated = 'July 25, 2026';
---

<Layout
  title="Terms of Service"
  description="Run The Math Terms of Service — rules and guidelines for using our free web tools and calculators."
>
  <div style="max-width: 800px; margin: 0 auto; padding: 4rem 1.5rem 6rem;">
    <div style="margin-bottom: 3rem; padding-bottom: 2rem; border-bottom: 1px solid #1E293B;">
      <span style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #6366F1;">Legal</span>
      <h1 style="font-size: 2.25rem; font-weight: 800; color: #F8FAFC; margin: 0.5rem 0 0.75rem; letter-spacing: -0.02em;">Terms of Service</h1>
      <p style="color: #64748B; font-size: 0.9rem; margin: 0;">Last updated: <time datetime="2026-07-25">{lastUpdated}</time></p>
    </div>

    <div style="color: #94A3B8; line-height: 1.8; font-size: 0.95rem;">

      <p style="margin-bottom: 1.5rem;">
        Please read these Terms of Service ("Terms", "Terms of Service") carefully before using the Run The Math website operated by us. Your access to and use of the Service is conditioned on your acceptance of and compliance with these Terms.
