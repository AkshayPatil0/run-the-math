        <p style="margin: 0; color: #94A3B8; font-size: 0.9rem;">
          <strong style="color: #F8FAFC;">Run The Math</strong><br />
          Email: <a href="mailto:legal@run-the-math.dev" style="color: #6366F1;">legal@run-the-math.dev</a>
        </p>
      </div>
    </div>
  </div>
</Layout>
