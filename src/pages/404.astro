---
import Layout from '../layouts/Layout.astro';
import Logo from '../components/Logo.astro';
---

<Layout title="404 — Page Not Found" description="The page you're looking for doesn't exist.">
  <div style="min-height: 60vh; display: flex; align-items: center; justify-content: center; padding: 4rem 1.5rem; text-align: center;">
    <div style="max-width: 480px; display: flex; flex-direction: column; align-items: center;">
      <Logo size="lg" style="margin-bottom: 1.5rem;" />
      <h1 style="font-size: 2rem; font-weight: 800; color: #F8FAFC; margin: 0 0 0.75rem; letter-spacing: -0.02em;">Page Not Found</h1>
      <p style="color: #64748B; font-size: 1rem; margin: 0 0 2rem; line-height: 1.6;">
        Looks like this tool doesn't exist yet — or the URL might be broken. Head back home to browse all available tools.
      </p>
      <a href="/" class="btn-primary" style="padding: 0.75rem 1.5rem;">
        ← Back to All Tools
      </a>
    </div>
  </div>
</Layout>
