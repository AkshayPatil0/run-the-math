---
interface Props {
  icon: string;
  title: string;
  description: string;
  category: string;
  categoryColor: string;
  /** null = tool not deployed yet (env var missing) → Coming Soon state */
  url: string | null;
  /** Internal hub route e.g. /tools/freelance-rate-calculator */
  href: string;
  index?: number;
}

const {
  icon,
  title,
  description,
  category,
  categoryColor,
  url,
  href,
  index = 0,
} = Astro.props;

const isLive = url !== null;

const delayMap: Record<number, string> = {
  0: "0ms",
  1: "80ms",
  2: "160ms",
  3: "240ms",
  4: "320ms",
  5: "400ms",
};
const delay = delayMap[index % 6] ?? "0ms";
---

<article
  class:list={["tool-card", !isLive && "tool-card--unavailable"]}
  data-title={title.toLowerCase()}
  data-category={category.toLowerCase()}
  style={`animation: fadeInUp 0.45s ease forwards; animation-delay: ${delay}; opacity: 0;`}
  aria-label={isLive ? title : `${title} — Coming Soon`}
>
  <!-- Top row: icon + badges -->
  <div
    style="display: flex; align-items: flex-start; justify-content: space-between; gap: 0.75rem;"
  >
    <div
      style={`width: 48px; height: 48px; border-radius: 12px; background: rgba(99,102,241,${isLive ? "0.12" : "0.06"}); border: 1px solid rgba(99,102,241,${isLive ? "0.2" : "0.1"}); display: flex; align-items: center; justify-content: center; font-size: 1.5rem; flex-shrink: 0; ${!isLive ? "filter: grayscale(0.5); opacity: 0.7;" : ""}`}
    >
      {icon}
    </div>

    <div
      style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.35rem;"
    >
      <!-- Category badge -->
      <span
        class="badge"
        style={`background-color: ${categoryColor}${isLive ? "20" : "12"}; color: ${isLive ? categoryColor : "#64748B"}; border: 1px solid ${categoryColor}${isLive ? "30" : "18"};`}
      >
        {category}
      </span>
      <!-- Coming Soon badge (only when not live) -->
      {
        !isLive && (
          <span
            class="badge"
            style="background-color: rgba(100,116,139,0.12); color: #64748B; border: 1px solid rgba(100,116,139,0.2);"
          >
            Coming Soon
          </span>
        )
      }
    </div>
  </div>

  <!-- Title -->
  <h3
    style={`font-size: 1.05rem; font-weight: 700; color: ${isLive ? "#F8FAFC" : "#64748B"}; margin: 0; line-height: 1.3; letter-spacing: -0.01em;`}
  >
    {title}
  </h3>

  <!-- Description -->
  <p
    style={`font-size: 0.875rem; color: ${isLive ? "#94A3B8" : "#475569"}; margin: 0; line-height: 1.55; flex: 1;`}
  >
    {description}
  </p>

  <!-- CTA -->
  {
    isLive ? (
      <a
        href={href}
        class="btn-primary"
        aria-label={`Open ${title}`}
        style="align-self: flex-start; margin-top: auto;"
      >
        Open Tool
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </a>
    ) : (
      <div
        role="status"
        aria-label="Tool coming soon"
        style="align-self: flex-start; margin-top: auto; display: inline-flex; align-items: center; gap: 0.375rem; background: rgba(100,116,139,0.08); color: #475569; font-size: 0.825rem; font-weight: 600; padding: 0.45rem 0.875rem; border-radius: 0.5rem; border: 1px dashed #334155; cursor: not-allowed; user-select: none;"
      >
        <svg
          width="13"
          height="13"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <>
            <circle cx="12" cy="12" r="10" />
            <polyline points="12 6 12 12 16 14" />
          </>
        </svg>
        Not deployed yet
      </div>
    )
  }
</article>

<style>
  .tool-card--unavailable {
    opacity: 0.6;
    border-style: dashed !important;
  }

  .tool-card--unavailable:hover {
    /* Override the live card hover — no lift, no glow */
    border-color: #334155 !important;
    transform: none !important;
    box-shadow: none !important;
  }

  .tool-card--unavailable::before {
    /* Suppress the accent top-border animation */
    display: none !important;
  }
</style>
