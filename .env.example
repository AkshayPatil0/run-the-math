# ============================================================
# ToolHub — Environment Configuration
# Copy this file to .env and fill in your subdomain URLs.
# ============================================================
#
# Convention:
#   PUBLIC_TOOL_<SLUG_UPPER>_URL=https://<subdomain>.yourdomain.com
#
# Rules:
#   - Variable MUST start with PUBLIC_ so Astro exposes it client-side.
#   - If a variable is missing or empty the tool shows as "Coming Soon"
#     on the homepage and returns a 404 from /tools/<slug>.
#   - Trailing slashes are fine — they will be trimmed automatically.
# ============================================================

# ── Finance ─────────────────────────────────────────────────
PUBLIC_TOOL_FREELANCE_RATE_CALCULATOR_URL=https://freelance.toolhub.dev
PUBLIC_TOOL_ELECTRICITY_COST_URL=https://electricity.toolhub.dev

# ── 3D Printing ─────────────────────────────────────────────
PUBLIC_TOOL_FILAMENT_COST_ESTIMATOR_URL=https://filament.toolhub.dev

# ── Coffee ───────────────────────────────────────────────────
PUBLIC_TOOL_COFFEE_BREW_RATIO_URL=https://coffee.toolhub.dev

# ── SaaS ─────────────────────────────────────────────────────
PUBLIC_TOOL_SAAS_CHURN_LTV_URL=https://saas.toolhub.dev

# ── Productivity ─────────────────────────────────────────────
PUBLIC_TOOL_SPRINT_PLANNER_URL=https://sprints.toolhub.dev

# ── (Future tools go here) ───────────────────────────────────
# PUBLIC_TOOL_MY_NEW_TOOL_URL=https://my-new-tool.toolhub.dev
